# Copie para .env e preencha:  cp .env.example .env
# O .env NÃO entra no Git.

# ---------- Banco (Postgres + pgvector) ----------
POSTGRES_USER=condominio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_OPENWEBUI_DB=openwebui
POSTGRES_CHATBOT_DB=chatbot
POSTGRES_PORT=5432

# Usado apenas ao rodar o backend fora do Docker.
# Vazio = SQLite local em backend/decisoes.db
# Ex. com o Postgres do compose: postgresql+psycopg://condominio:troque-esta-senha@localhost:5432/chatbot
DATABASE_URL=

# ---------- Backend ----------
BACKEND_PORT=8000
# Chave compartilhada entre Open WebUI e backend (gere com: openssl rand -hex 32)
BACKEND_API_KEY=troque-esta-chave
# Pasta com a base (Markdown) e os CSVs. No Docker é sobrescrito para /dados
DADOS_DIR=../dados

# Estratégia de chunking: artigo | caracteres (1000 com 200 de sobreposição)
CHUNK_STRATEGY=artigo
# Limiares (calibrar no conjunto de validação, nunca no de teste)
LIMIAR_CLASSIFICADOR=0.35
LIMIAR_SIMILARIDADE=0.10
TOP_K=3

ADMIN_CONTATO=Administração: (11) 0000-0000 · adm@jardimdasacacias.exemplo · Portaria: ramal 9

# ---------- LLM (opcional) ----------
# Sem chave, o bot devolve o trecho citado (modo extrativo, padrão da POC).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_HABILITADO=true

# ---------- Open WebUI ----------
OPENWEBUI_PORT=3000
OPENWEBUI_TAG=main
# gere com: openssl rand -hex 32
WEBUI_SECRET_KEY=troque-este-segredo
WEBUI_NAME=Assistente Jardim das Acácias
